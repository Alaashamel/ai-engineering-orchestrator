# AI Engineering Orchestrator - Environment Configuration
# Copy this file to .env and adjust values

# Application
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://app:app_password@localhost:5432/ai_software_company

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT / Auth
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# LLM Provider
# Leave blank to use mock mode (no LLM calls)
LLM_API_KEY=
LLM_MODEL=gpt-4o

# CORS
